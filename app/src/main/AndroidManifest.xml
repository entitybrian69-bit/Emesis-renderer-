<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.entitybrian.emesis"
    android:versionCode="100"
    android:versionName="1.0.0">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- Optional storage permissions for reading/writing /sdcard/EmesisRenderer/config.json -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Universal Minecraft: Java Edition Launcher Renderer Plugin Flags -->
        <meta-data
            android:name="fclPlugin"
            android:value="true" />
        <meta-data
            android:name="zalithRendererPlugin"
            android:value="true" />
        <meta-data
            android:name="pgwRendererPlugin"
            android:value="true" />

        <!-- Plugin Display Description & Native GL/EGL Entrypoints -->
        <meta-data
            android:name="des"
            android:value="Emesis Renderer (All Versions — Made by Entitybrian)" />
        <meta-data
            android:name="renderer"
            android:value="EmesisRenderer:libemesis_renderer.so:libemesis_renderer.so" />

        <!-- Boat & Pojav/FCL/Zalith Environment Definitions -->
        <meta-data
            android:name="boatEnv"
            android:value="LIBGL_USE_MC_COLOR=1:LIBGL_GL=31:LIBGL_ES=3:LIBGL_NORMALIZE=1:LIBGL_NOINTOVLHACK=1:LIBGL_NOERROR=1" />
        <meta-data
            android:name="pojavEnv"
            android:value="LIBGL_USE_MC_COLOR=1:LIBGL_GL=31:LIBGL_ES=3:LIBGL_NORMALIZE=1:LIBGL_NOINTOVLHACK=1:LIBGL_NOERROR=1:POJAV_RENDERER=opengles3" />

    </application>

</manifest>
