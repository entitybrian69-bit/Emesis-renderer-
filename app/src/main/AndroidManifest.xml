<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional storage permissions for reading/writing /sdcard/EmesisRenderer/config.json and Pojav custom_env.txt -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Android 11+ (API 30+) package visibility across all PojavLauncher variants & successors -->
    <queries>
        <!-- Legacy v1.0 package detection for one-tap cleanup -->
        <package android:name="com.entitybrian.emesis" />
        <!-- Official PojavLauncher & CI/Debug/Beta/Custom builds -->
        <package android:name="net.kdt.pojavlaunch" />
        <package android:name="net.kdt.pojavlaunch.debug" />
        <package android:name="net.kdt.pojavlaunch.canary" />
        <package android:name="net.kdt.pojavlaunch.beta" />
        <package android:name="net.kdt.pojavlaunch.firefly" />
        <!-- Pojav Glow Worm / PojavZH -->
        <package android:name="com.movtery.pojavzh" />
        <package android:name="com.movtery.pojavzh.debug" />
        <!-- ZalithLauncher 1 & ZalithLauncher 2 -->
        <package android:name="com.movtery.zalithlauncher" />
        <package android:name="com.movtery.zalithlauncher.debug" />
        <package android:name="com.movtery.zalithlauncher.v2" />
        <package android:name="com.movtery.zalithlauncher.v2.debug" />
        <!-- Amethyst (PojavLauncher continuation) -->
        <package android:name="org.angelauramc.amethyst" />
        <package android:name="org.angelauramc.amethyst.debug" />
        <package android:name="io.stamethyst" />
        <!-- MojoLauncher & SolCraftLauncher -->
        <package android:name="git.artdeell.mojo" />
        <package android:name="git.artdeell.mojo.debug" />
        <package android:name="git.artdeell.solcraft" />
        <package android:name="com.soldev.solcraft" />
        <!-- FoldCraftLauncher & variants -->
        <package android:name="com.tungsten.fcl" />
        <package android:name="com.tungsten.fcm" />
        <package android:name="com.tungsten.fcl.ngg" />
        <package android:name="org.fcl.enchantnet" />
        <!-- QuestCraft VR PojavLauncher -->
        <package android:name="com.qcxr.qcxr" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="com.entitybrian.emesis.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Automatic background custom_env.txt path updater on APK upgrade (Android 11+ randomized /data/app/~~... fix) -->
        <receiver
            android:name="com.entitybrian.emesis.EmesisUpdateReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- RendererPlugin V2 Schema (ZalithLauncher 2 / FoldCraftLauncher V2) -->
        <meta-data
            android:name="fclPlugin_V2"
            android:resource="@string/emesis_v2_config" />
        <meta-data
            android:name="emesis_title_routing_mode"
            android:resource="@string/emesis_title_routing_mode" />
        <meta-data
            android:name="emesis_title_disable_shader_cache"
            android:resource="@string/emesis_title_disable_shader_cache" />
        <meta-data
            android:name="emesis_title_hide_buffer_storage"
            android:resource="@string/emesis_title_hide_buffer_storage" />
        <meta-data
            android:name="emesis_title_timer_query"
            android:resource="@string/emesis_title_timer_query" />

        <!-- RendererPlugin V1 Flags (Pojav Glow Worm / Pojav Beta-Zink / Pojav Firefly / Zalith 1 & 2 / FCL) -->
        <meta-data
            android:name="fclPlugin"
            android:value="true" />
        <meta-data
            android:name="zalithRendererPlugin"
            android:value="true" />
        <meta-data
            android:name="pgwRendererPlugin"
            android:value="true" />

        <!-- Plugin Display Description & Native GL/EGL Entrypoints (leading '/' resolves full nativeLibraryDir for EGL) -->
        <meta-data
            android:name="des"
            android:value="Emesis Renderer v1.2.7 (All Versions — Made by Entitybrian)" />
        <meta-data
            android:name="renderer"
            android:value="EmesisRenderer:libemesis_renderer.so:/libemesis_renderer.so" />
        <meta-data
            android:name="minMCVer"
            android:value="" />
        <meta-data
            android:name="maxMCVer"
            android:value="" />

        <!-- Boat & Pojav/PGW/Zalith/FCL Environment Definitions -->
        <meta-data
            android:name="boatEnv"
            android:value="LIBGL_USE_MC_COLOR=1:LIBGL_GL=31:LIBGL_ES=3:LIBGL_MIPMAP=3:LIBGL_NORMALIZE=1:LIBGL_NOINTOVLHACK=1:LIBGL_NOERROR=1:DLOPEN=libemesis_renderer.so" />
        <meta-data
            android:name="pojavEnv"
            android:value="POJAV_RENDERER=opengles3:LIBGL_USE_MC_COLOR=1:LIBGL_GL=31:LIBGL_ES=3:LIBGL_MIPMAP=3:LIBGL_NORMALIZE=1:LIBGL_NOINTOVLHACK=1:LIBGL_NOERROR=1:DLOPEN=libemesis_renderer.so" />

    </application>

</manifest>
